{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:diagnostic": "tsx src/services/diagnosticEngine.test.ts",
    "test:questions": "tsx src/services/questionsEngine.test.ts",
    "test:mastery": "tsx src/services/masteryEngine.test.ts",
    "test:reviews": "tsx src/services/reviewsEngine.test.ts",
    "test:presentation": "tsx src/services/reviewPresentation.test.ts",
    "test:efficiency": "tsx src/services/efficiencyEngineV2.test.ts",
    "test:efficiency-integration": "tsx src/services/efficiencyDecisionOrchestrator.test.ts",
    "test:efficiency-action": "tsx src/services/efficiencyActionResolver.test.ts",
    "test": "npm run test:diagnostic && npm run test:questions && npm run test:mastery && npm run test:reviews && npm run test:presentation && npm run test:efficiency && npm run test:efficiency-integration && npm run test:efficiency-action"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
